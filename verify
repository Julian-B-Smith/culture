#!/usr/bin/env bash
# verify — oracle dispatcher. The harness's only interface to project QC.
# Usage: ./verify fast | full | report
# Contract: exit 0 = green, nonzero = red. Writes .harness/last-verify.json.
#
# THIS FILE IS PROJECT-OWNED: edit `fast` and `full` freely, add project gates,
# wire your test commands. The kit-owned gates live in `.kit/kit-gates.sh`,
# which is vendored and checksummed — do not edit that one, and do not copy its
# contents here. Update it with:  python3 <kit>/kit_sync.py .
set -uo pipefail

TARGET="${1:-fast}"
HARNESS_DIR=".harness"
mkdir -p "$HARNESS_DIR"

# Kit-owned gates: record, leak_gate, kit_integrity. A repo missing this file
# is not a lesser repo, it is an UNGATED one, so failing loudly beats degrading
# quietly — a silently skipped privacy gate is exactly the shape of bug the
# gate exists to prevent.
if [ -r .kit/kit-gates.sh ]; then
  . .kit/kit-gates.sh
else
  echo "verify: .kit/kit-gates.sh missing — run kit_sync.py (gates cannot be skipped)" >&2
  exit 1
fi

# ---- Project gates ----------------------------------------------------------
#
# Since D-030 (2026-10-02) the C++ core is CANONICAL. The JS reference is frozen
# at tag v0-js-parity, where it was proven bit-identical to libculture; its
# goldens are archived in golden/js-v1/. The oracle is now:
#   - pinned C++ goldens (golden/*.jsonl) and pinned deep goldens
#     (golden/deep/*.txt: every hidden array, scalar and stat, every gen),
#     which guard against any UNINTENDED change;
#   - core_ref, a frozen naive C++ core, as the independent second
#     implementation every optimized core must match;
#   - cross-toolchain parity: CI (Linux, GCC, glibc) checks these same pins,
#     which were generated with Apple clang;
#   - property tests that no golden can provide.
# An INTENDED change to the simulation is a DECISIONS entry that regenerates
# and re-pins the goldens in the same commit.

# The files the charter and ROADMAP point at. A missing one means an agent
# would orient against nothing, so it is red, not a warning.
structure_gate() {
  local ok=0 f
  for f in CLAUDE.md README.md ROADMAP.md DECISIONS.md INDEX.md LIBRARY.md \
           project.manifest.json tools/compare.js golden/PINS.sha256 traces/README.md \
           CMakeLists.txt core/src/core.cpp core/src/fdlibm.hpp core/ref/core_ref.cpp \
           tests/vectors.expected tests/trig.expected tests/properties.cpp; do
    [ -e "$f" ] || { echo "structure_gate: missing $f" >&2; ok=1; }
  done
  python3 -c 'import json,sys; m=json.load(open("project.manifest.json")); sys.exit(0 if m["survey"]["architecture_rung"]["choice"] in (1,2,3) else 1)' \
    || { echo "structure_gate: project.manifest.json unparseable or rung missing" >&2; ok=1; }
  [ "$ok" = 0 ] && echo "structure_gate: ok"
  return $ok
}

# Every oracle file is pinned by sha256: the C++ goldens and deep goldens, the
# expected vector/trig outputs, the comparator, and the frozen JS hand-over
# set (reference/, golden/js-v1/, tests/js/). They change only through a
# DECISIONS entry that also re-pins (D-023, D-030). Without the pin, "never
# regenerate the goldens casually" is a sentence; with it, a red build.
golden_pin_gate() {
  if shasum -a 256 -c golden/PINS.sha256 >/dev/null 2>&1; then
    echo "golden_pin_gate: ok ($(wc -l < golden/PINS.sha256 | tr -d ' ') files)"
  else
    echo "golden_pin_gate: FAIL — a pinned oracle file changed:" >&2
    shasum -a 256 -c golden/PINS.sha256 2>&1 | grep -v ': OK$' >&2
    return 1
  fi
}

# compare.js must PASS a golden against itself AND FAIL on a planted
# divergence. A comparator that never fires would make every future port
# trace green (kit README: assert the effective state — prove the detector
# fires, then trust its silence).
compare_selftest() {
  local tmp g=golden/default-seed-1.jsonl
  tmp="$(mktemp -d)"
  # Here pipefail helps: compare.js must also EXIT 0, not just print PASS.
  node tools/compare.js "$g" "$g" | grep -q '^PASS' \
    || { echo "compare_selftest: FAIL — golden vs itself did not PASS" >&2; rm -rf "$tmp"; return 1; }
  # Plant: flip one tier count in generation 1000's line (line 1001; line 1 is the header).
  node -e '
    const fs=require("fs"); const L=fs.readFileSync(process.argv[1],"utf8").split("\n");
    const o=JSON.parse(L[1000]); o.tiers+=1; L[1000]=JSON.stringify(o);
    fs.writeFileSync(process.argv[2], L.join("\n"));' "$g" "$tmp/planted.jsonl"
  # Capture, don't pipe: compare.js exits 1 on FAIL, and under `pipefail` a
  # `| grep -q` pipeline would then report failure even when grep matched.
  local out; out="$(node tools/compare.js "$g" "$tmp/planted.jsonl")"
  if printf '%s\n' "$out" | grep -q '^FAIL at line 1001'; then
    echo "compare_selftest: ok (self PASS, planted divergence caught at line 1001)"
    rm -rf "$tmp"; return 0
  fi
  echo "compare_selftest: FAIL — planted divergence not caught" >&2
  rm -rf "$tmp"; return 1
}

# Release build into build/ (Command Line Tools: Unix Makefiles only). The
# build dir is absolute because the agent sandbox resets cwd between calls,
# and a relative `cmake --build build` can silently build nothing.
cpp_build() {
  command -v cmake >/dev/null || { echo "cpp_build: cmake not found" >&2; return 1; }
  local b="$PWD/build" log
  # Reconfigure unless the cache is a Release one: a Debug cache in build/
  # would make the parity gates pass on -O0 code and the bench meaningless.
  if ! grep -q '^CMAKE_BUILD_TYPE:STRING=Release$' "$b/CMakeCache.txt" 2>/dev/null; then
    log="$(cmake -S "$PWD" -B "$b" -G "Unix Makefiles" -DCMAKE_BUILD_TYPE=Release 2>&1)" \
      || { echo "cpp_build: configure FAILED" >&2; printf '%s\n' "$log" >&2; return 1; }
  fi
  log="$(cmake --build "$b" -j"$(getconf _NPROCESSORS_ONLN 2>/dev/null || echo 4)" 2>&1)" \
    || { echo "cpp_build: build FAILED" >&2; printf '%s\n' "$log" | grep -E 'error|Error' | head -20 >&2; return 1; }
  echo "cpp_build: ok (Release)"
}

# Unit vectors: RNG, hash32, ruleStr, screen, growth, pow, log2 — the C++
# output must equal tests/vectors.expected (proven equal to the JS at the
# hand-over; doubles printed as raw bit patterns).
cpp_vectors() {
  local d
  if d="$(diff tests/vectors.expected <("$PWD/build/culture_vectors"))"; then
    echo "cpp_vectors: ok ($(wc -l < tests/vectors.expected | tr -d ' ') vectors bit-identical to pinned)"
  else
    echo "cpp_vectors: FAIL — C++ differs from tests/vectors.expected:" >&2; printf '%s\n' "$d" | head -20 >&2; return 1
  fi
}

# fdlibm sin/cos (core/src/fdlibm.hpp, D-027): one hash over 2.24M values,
# pinned. On CI this is a cross-toolchain check of the explicit-fma port.
cpp_trig() {
  local want got
  want="$(cat tests/trig.expected)"
  got="$("$PWD/build/culture_vectors" --trig)"
  [ "$got" = "$want" ] || { echo "cpp_trig: FAIL — C++ fdlibm '$got' != pinned '$want'" >&2; return 1; }
  echo "cpp_trig: ok (2.24M cos/sin values = pinned)"
}

# Golden traces through tools/compare.js, with no float tolerance. compare.js
# skips the header and checks every generation plus the births footer.
# Args: "<profile> <seed>" pairs.
cpp_parity() {
  local tmp ok=0 pair profile seed out
  tmp="$(mktemp -d)"
  for pair in "$@"; do
    profile="${pair% *}"; seed="${pair#* }"
    "$PWD/build/culture_trace" --profile "$profile" --out "$tmp" "$seed" >/dev/null || { ok=1; continue; }
    out="$(node tools/compare.js "golden/$profile-seed-$seed.jsonl" "$tmp/$profile-seed-$seed.jsonl" --float-rel 0)"
    case "$out" in
      PASS*) echo "cpp_parity: $profile-seed-$seed $out" ;;
      *)     echo "cpp_parity: $profile-seed-$seed $out" >&2; ok=1 ;;
    esac
  done
  rm -rf "$tmp"
  return $ok
}

# Deep parity against the pinned deep goldens, for one core ("opt" = the
# optimized culture::World, "ref" = the frozen naive core_ref). The goldens
# hash only alive/tier; a planted `0.8f` in the pressure decay passed all of
# them and this caught it at gen 866 (D-025). The output must have exactly
# <gens> lines: an empty output would otherwise "match" nothing at all.
# Args: core, then "<profile> <seed> <gens>" triples.
deep_check() {
  local core="$1" ok=0 t profile seed gens d out g
  shift
  for t in "$@"; do
    read -r profile seed gens <<<"$t"
    g="golden/deep/$profile-seed-$seed.txt"
    out="$("$PWD/build/culture_trace" --deep --core "$core" --profile "$profile" --gens "$gens" "$seed")"
    if [ "$(printf '%s\n' "$out" | wc -l | tr -d ' ')" != "$gens" ]; then
      echo "deep[$core]: FAIL $profile-seed-$seed — expected $gens lines" >&2; ok=1; continue
    fi
    if d="$(diff "$g" <(printf '%s\n' "$out"))"; then
      echo "deep[$core]: $profile-seed-$seed hidden state = pinned for $gens gens"
    else
      echo "deep[$core]: FAIL $profile-seed-$seed — first divergence (columns: trace/main.cpp runDeep):" >&2
      printf '%s\n' "$d" | head -4 >&2; ok=1
    fi
  done
  return $ok
}

# Determinism and never-repeat (tests/properties.cpp).
cpp_props() {
  local out
  if out="$("$PWD/build/culture_properties")"; then
    printf '%s\n' "$out" | sed 's/^/cpp_props: /'
  else
    printf '%s\n' "$out" | sed 's/^/cpp_props: /' >&2; return 1
  fi
}

# P1 acceptance 2: a 440x280 world steps in < 4 ms (Release). Mean over 4000
# steps after a 50-step warm-up, search excluded (it moves to a worker),
# for seeds 1-3; every seed must pass. 4000 steps because a short run is
# still single-tier and flatters the number (measured: 3.1 ms at 1 tier vs
# 4.1-5.0 ms once 5-8 tiers exist, before the hot-loop work).
cpp_bench() {
  local s line ms ok=0
  for s in 1 2 3; do
    line="$("$PWD/build/culture_trace" --bench 440x280 --gens 4000 --seed "$s")" || { ok=1; continue; }
    ms="$(printf '%s' "$line" | sed -E 's/.*: ([0-9.]+) ms\/step.*/\1/')"
    if awk -v m="$ms" 'BEGIN{exit !(m < 4.0)}'; then echo "cpp_bench: $line"
    else echo "cpp_bench: OVER BUDGET (4 ms) — $line" >&2; ok=1; fi
  done
  return $ok
}

fast() {
  # ---- Layer-0: seconds, not minutes. CI-blocking. -------------------------
  local ok=0
  kit_integrity || ok=1      # kit-owned files must match .kit/MANIFEST
  leak_gate     || ok=1      # privacy gate: kit-core, keep it first
  structure_gate   || ok=1
  golden_pin_gate  || ok=1
  compare_selftest || ok=1
  if cpp_build; then
    cpp_vectors || ok=1
    cpp_trig || ok=1
    cpp_parity "default 1" || ok=1
    deep_check opt "default 1 3000" "chaos 7 4000" || ok=1
    deep_check ref "default 1 3000" "chaos 7 4000" || ok=1
    cpp_props || ok=1
  else
    ok=1
  fi
  return $ok
}

full() {
  fast || return $?
  # ---- Layer-E: the whole gate. Run before closing a queue item. -----------
  local ok=0
  cpp_parity "default 2" "default 3" "stress 4" || ok=1
  deep_check opt "default 2 3000" "default 3 3000" "stress 4 5000" "chaos 11 4000" || ok=1
  deep_check ref "default 2 3000" "default 3 3000" "stress 4 5000" "chaos 11 4000" || ok=1
  cpp_bench || ok=1
  return $ok
}

case "$TARGET" in
  fast)   fast;  record fast  $? ;;
  full)   full;  record full  $? ;;
  report) cat "$HARNESS_DIR/last-verify.json" 2>/dev/null || { echo '{"target":null,"exit":null}'; exit 1; } ;;
  *)      echo "usage: ./verify fast|full|report" >&2; exit 64 ;;
esac
